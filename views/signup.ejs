<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel='stylesheet' href='/stylesheets/style.css'/>
</head>
<body>
  <div class="container">
    <div class="card">
      <div class="card-header">
        ✨ 新規登録
      </div>
      <div class="card-body">
        <%- include('./error_messages'); %>
        
        <form action="/signup" method="post">
          <div class="mb-3">
            <label for="username" class="form-label">ユーザ名</label>
            <input 
              required 
              type="text" 
              id="username"
              name="username" 
              class="form-control"
              placeholder="ユーザ名を入力（3文字以上）"
            />
          </div>

          <div class="mb-3">
            <label for="password" class="form-label">パスワード</label>
            <input 
              required 
              type="password" 
              id="password"
              name="password" 
              class="form-control"
              placeholder="パスワードを入力（8文字以上推奨）"
            />
          </div>

          <div class="mb-3">
            <label for="repassword" class="form-label">パスワード再入力</label>
            <input 
              required 
              type="password" 
              id="repassword"
              name="repassword" 
              class="form-control"
              placeholder="パスワードを再入力"
            />
          </div>

          <button type="submit" class="btn btn-primary w-100">
            新規登録
          </button>
        </form>

        <div class="auth-link">
          アカウントをお持ちですか？ 
          <a href="/signin">サインイン</a>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>