<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>エラー</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel='stylesheet' href='/stylesheets/style.css'/>
</head>
<body>
  <div class="container">
    <div class="card mt-5">
      <div class="card-header" style="background: linear-gradient(90deg, #ef5350, #f44336) !important;">
        ❌ エラーが発生しました
      </div>
      <div class="card-body text-center">
        <h2 class="text-danger mb-3"><%= error.status %></h2>
        <h5 class="mb-4"><%= message %></h5>
        
        <% if (process.env.NODE_ENV === 'development') { %>
          <div class="alert alert-info text-start">
            <strong>詳細情報（開発環境）:</strong>
            <pre style="margin-top: 1rem; background-color: #f5f5f5; padding: 1rem; border-radius: 5px; overflow-x: auto;"><%= error.stack %></pre>
          </div>
        <% } %>

        <a href="/" class="btn btn-primary mt-3">ホームに戻る</a>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
