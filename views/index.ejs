<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel='stylesheet' href='/stylesheets/style.css'/>
</head>
<body>
  <% if(isAuth) { %>
    <nav class="navbar navbar-expand-lg navbar-dark">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">✓ TodoApp</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <a class="nav-link" href="/logout">ログアウト</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>
  <% } %>

  <% if(isAuth) { %>
    <div class="container">
      <%- include('./error_messages'); %>
      <div class="card">
        <div class="card-header">
          📝 タスク管理
        </div>
        <div class="card-body">
          <form action="/" method="post" class="add-todo-form">
            <input 
              required 
              type="text" 
              name="add" 
              placeholder="新しいタスクを入力..."
              class="form-control"
            />
            <button type="submit" class="btn btn-success">追加</button>
          </form>

          <% if(todos && todos.length > 0) { %>
            <div class="todo-list">
              <h5 class="todo-list-title">📋 タスク一覧 (<%= todos.length %>)</h5>
              <div class="todo-items">
                <% for(let todo of todos){ %>
                  <div class="todo-item">
                    <span class="todo-content"><%= todo.content %></span>
                  </div>
                <% } %>
              </div>
            </div>
          <% } else { %>
            <div class="todo-empty">
              <div class="todo-empty-icon">🎉</div>
              <p>タスクがありません。新しいタスクを追加して始めましょう！</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  <% } else { %>
    <div class="container">
      <div class="welcome-section">
        <h1>📝 TodoApp へようこそ</h1>
        <p>シンプルで効率的なタスク管理アプリケーション</p>
        <a href="/signup" class="btn btn-sign-up">サインアップして始める</a>
        <div class="mt-3" style="font-size: 0.95rem; opacity: 0.9;">
          アカウントを持っていますか？ <a href="/signin" style="color: white; text-decoration: underline;">サインイン</a>
        </div>
      </div>
    </div>
  <% } %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>